# XAMPP / Apache — serve the static Next.js export from /ConstructFlow/
DirectoryIndex out/index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /ConstructFlow/

  # PHP API, storage, and template files
  RewriteRule ^api/ - [L]
  RewriteRule ^storage/ - [L]
  RewriteRule ^templates/ - [L]

  # Built static assets and logos
  RewriteRule ^_next/(.*)$ out/_next/$1 [L]
  RewriteRule ^img/(.*)$ out/img/$1 [L]
  RewriteRule ^favicon\.svg$ out/favicon.svg [L]

  # Static-export shells for database-backed dynamic routes.
  RewriteRule ^reports/view/[^/]+/?$ out/reports/view/index.html [L]
  RewriteRule ^swa-stewa/edit/[^/]+/?$ out/swa-stewa/edit/index.html [L]

  # Existing files (out, api, database, etc.)
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # Next static routes → their generated index.html files.
  RewriteRule ^$ out/index.html [L]
  RewriteRule ^(.*)/?$ out/$1/index.html [L]
</IfModule>
