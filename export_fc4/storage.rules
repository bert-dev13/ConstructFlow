rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    match /reports/{allPaths=**} {
      allow read: if true;
      allow write: if signedIn();
    }

    match /templates/{allPaths=**} {
      allow read: if signedIn();
      allow write: if signedIn();
    }
  }
}
