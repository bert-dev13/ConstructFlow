# Local Apache/XAMPP static export only. Leave unset/empty on Vercel.
NEXT_PUBLIC_BASE_PATH=/ConstructFlow

# Firebase web config (from Firebase Console → Project settings)
# These are public client keys (safe for NEXT_PUBLIC_). Do not put private service-account keys here.
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyCP8rGySmmAcy_i8UfQxnus5Cfc0wJVRN0
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=constructflow-c82cd.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=constructflow-c82cd
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=constructflow-c82cd.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=173177123241
NEXT_PUBLIC_FIREBASE_APP_ID=1:173177123241:web:cb0aea82e4e8e9cf1cd4b8

# Optional: Cloud Functions SMTP (set in Firebase Functions secrets / functions/.env — NOT Vercel)
# Email is sent by Cloud Functions, not the Next.js app.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=peo-monitoring@cagayan.gov.ph
# MAIL_TO=

# Vercel production notes:
# - Do NOT set NEXT_PUBLIC_BASE_PATH (app is served at /)
# - Copy the NEXT_PUBLIC_FIREBASE_* values above into Vercel Project → Settings → Environment Variables
# - Do not add private keys / service accounts as NEXT_PUBLIC_* variables
# - Add your Vercel domain under Firebase Auth → Authorized domains
